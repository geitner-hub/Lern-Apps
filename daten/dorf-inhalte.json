  "BEWOHNER": [
    {"id": "yusuf", "name": "Yusuf", "icon": "👨🏽‍🍳", "text": "kocht im Dorfcafé Gerichte aus aller Welt", "farben": ["#f59e0b", "#1f2937", "#1c1917"], "geschichten": [{"text": "Yusuf probiert ein neues Rezept. Er braucht jemanden, der ganz genau abmisst.", "stueck": {"id": "yusuf-gewuerz", "name": "Gewürzdose", "icon": "🫙"}}, {"text": "Yusuf lädt das ganze Dorf zum Essen ein. Hilfst du beim Tischdecken für alle?", "stueck": {"id": "yusuf-teeglas", "name": "Buntes Teeglas", "icon": "🍵"}}]},
    {"id": "resi", "name": "Oma Resi", "icon": "👵", "text": "strickt für das ganze Dorf", "farben": ["#c2410c", "#57534e", "#e7e5e4"], "geschichten": [{"text": "Oma Resi hat ihre Brille verlegt. Wenn du ihr beim Suchen hilfst, strickt sie dir etwas Warmes.", "stueck": {"id": "resi-socken", "name": "Gestrickte Socken", "icon": "🧦"}}, {"text": "Oma Resi backt für das Dorffest und braucht eine Hilfe in der Küche.", "stueck": {"id": "resi-rezept", "name": "Resis Kuchenrezept", "icon": "📜"}}]},
    {"id": "amara", "name": "Amara", "icon": "👩🏿", "text": "fährt den Dorfbus", "farben": ["#0ea5e9", "#1e3a8a", "#1c1917"], "geschichten": [{"text": "Im Busfahrplan ist alles durcheinander. Amara und du bringt die Zeiten wieder in Ordnung.", "stueck": {"id": "amara-fahrkarte", "name": "Busfahrkarte", "icon": "🎫"}}, {"text": "Amara plant eine Ausflugsfahrt ans Meer. Wie weit ist es und wie lange dauert es?", "stueck": {"id": "amara-kompass", "name": "Kleiner Kompass", "icon": "🧭"}}]},
    {"id": "luca", "name": "Luca", "icon": "🧑🏻‍🎨", "text": "malt Bilder auf Hauswände", "farben": ["#e11d48", "#334155", "#78350f"], "geschichten": [{"text": "Luca malt ein großes Bild an die Rathauswand. Aber welche Farbe fehlt noch?", "stueck": {"id": "luca-pinsel", "name": "Lucas Pinsel", "icon": "🖌️"}}, {"text": "Luca will einen Regenbogen malen und mischt die Farben. Mischst du mit?", "stueck": {"id": "luca-palette", "name": "Farbpalette", "icon": "🎨"}}]},
    {"id": "oksana", "name": "Oksana", "icon": "👩🏼‍⚕️", "text": "ist die Tierärztin im Dorf", "farben": ["#f8fafc", "#0f766e", "#fde68a"], "geschichten": [{"text": "Oksana pflegt einen kleinen Igel gesund. Er braucht jeden Tag genau das richtige Futter.", "stueck": {"id": "oksana-igel", "name": "Igel-Zeichnung", "icon": "🦔"}}, {"text": "Oksana zählt die Vögel am Futterhaus. Zählst du mit?", "stueck": {"id": "oksana-feder", "name": "Bunte Feder", "icon": "🪶"}}]},
    {"id": "sepp", "name": "Bauer Sepp", "icon": "👨‍🌾", "text": "fährt einen alten Traktor", "farben": ["#15803d", "#1e3a8a", "#78350f"], "geschichten": [{"text": "Sepps Traktor springt nicht an. Er rechnet, welches Teil fehlt – rechnest du mit?", "stueck": {"id": "sepp-schluessel", "name": "Traktor-Schlüssel", "icon": "🔑"}}, {"text": "Die Kartoffeln sind reif! Sepp braucht fleißige Hände auf dem Acker.", "stueck": {"id": "sepp-kartoffel", "name": "Riesen-Kartoffel", "icon": "🥔"}}]},
    {"id": "priya", "name": "Doktor Priya", "icon": "👩🏽‍⚕️", "text": "hilft, wenn jemand krank ist", "farben": ["#8b5cf6", "#1f2937", "#1c1917"], "geschichten": [{"text": "In der Praxis sind die Pflaster ausgegangen. Doktor Priya zählt den Vorrat.", "stueck": {"id": "priya-pflaster", "name": "Pflaster-Dose", "icon": "🩹"}}, {"text": "Doktor Priya kocht Kräutertee für alle, die erkältet sind. Weißt du, welche Kräuter helfen?", "stueck": {"id": "priya-minze", "name": "Minzblatt", "icon": "🌿"}}]},
    {"id": "kenji", "name": "Kenji", "icon": "👦🏻", "text": "will einmal Astronaut werden", "farben": ["#1d4ed8", "#475569", "#111827"], "geschichten": [{"text": "Kenji beobachtet nachts die Sterne. Hilf ihm, die Sternbilder zu zählen!", "stueck": {"id": "kenji-fernrohr", "name": "Kleines Fernrohr", "icon": "🔭"}}, {"text": "Heute Nacht soll eine Sternschnuppe kommen. Kenji rechnet aus, wann genau.", "stueck": {"id": "kenji-sternschnuppe", "name": "Sternschnuppe im Glas", "icon": "🌠"}}]},
    {"id": "malik", "name": "Malik", "icon": "🧑🏾‍🔧", "text": "repariert alle Fahrräder im Dorf", "farben": ["#ea580c", "#374151", "#111827"], "geschichten": [{"text": "Ein Fahrrad hat einen Platten. Malik flickt ihn – du reichst die Werkzeuge.", "stueck": {"id": "malik-klingel", "name": "Fahrradklingel", "icon": "🔔"}}, {"text": "Malik baut ein Tandem für zwei. Wie lang muss die Kette sein?", "stueck": {"id": "malik-werkzeug", "name": "Schraubenschlüssel", "icon": "🔧"}}]},
    {"id": "linh", "name": "Linh", "icon": "👩🏻", "text": "bringt als Postbotin jeden Brief ans Ziel", "farben": ["#eab308", "#1e40af", "#111827"], "geschichten": [{"text": "Ein Brief hat keine Adresse. Linh und du findet heraus, wem er gehört.", "stueck": {"id": "linh-marke", "name": "Seltene Briefmarke", "icon": "✉️"}}, {"text": "Vor dem Dorffest kommen ganz viele Päckchen. Linh sortiert sie – sortierst du mit?", "stueck": {"id": "linh-paket", "name": "Kleines Päckchen", "icon": "📦"}}]},
    {"id": "elena", "name": "Elena", "icon": "👩🏼‍🎤", "text": "spielt Geige im Dorforchester", "farben": ["#be123c", "#111827", "#a16207"], "geschichten": [{"text": "Elenas Geige klingt schief. Übt zusammen, bis jeder Ton sitzt.", "stueck": {"id": "elena-noten", "name": "Notenblatt", "icon": "🎼"}}, {"text": "Das Dorforchester probt für ein Konzert. Elena braucht jemanden, der den Takt hält.", "stueck": {"id": "elena-konzert", "name": "Konzertkarte", "icon": "🎟️"}}]},
    {"id": "tomasz", "name": "Tomasz", "icon": "🧔🏼", "text": "ist bei der Dorffeuerwehr", "farben": ["#dc2626", "#1f2937", "#a16207"], "geschichten": [{"text": "Die Feuerwehr übt heute. Tomasz braucht jemanden, der gut mitdenkt.", "stueck": {"id": "tomasz-helm", "name": "Feuerwehrhelm", "icon": "⛑️"}}, {"text": "Katze Minka sitzt oben im Baum. Tomasz holt die Leiter – du passt auf.", "stueck": {"id": "tomasz-leiter", "name": "Kleine Leiter", "icon": "🪜"}}]},
    {"id": "ana", "name": "Ana", "icon": "👩🏽‍🌾", "text": "liebt ihren Blumengarten", "farben": ["#db2777", "#65a30d", "#1c1917"], "geschichten": [{"text": "Ana will die größten Sonnenblumen im Dorf ziehen. Hilf ihr beim Gießen!", "stueck": {"id": "ana-kerne", "name": "Sonnenblumenkerne", "icon": "🌻"}}, {"text": "Schnecken fressen Anas Salat. Gemeinsam findet ihr eine Lösung.", "stueck": {"id": "ana-schnecke", "name": "Leeres Schneckenhaus", "icon": "🐌"}}]},
    {"id": "omar", "name": "Opa Omar", "icon": "👴🏽", "text": "erzählt die spannendsten Geschichten", "farben": ["#4b5563", "#78350f", "#f5f5f4"], "geschichten": [{"text": "Opa Omar spielt Schach und sucht eine Figur. Sie muss irgendwo im Dorf sein!", "stueck": {"id": "omar-schach", "name": "Schachfigur", "icon": "♟️"}}, {"text": "Opa Omar erzählt von einer langen Reise. Hör gut zu und rechne mit!", "stueck": {"id": "omar-karte", "name": "Alte Landkarte", "icon": "🗺️"}}]},
    {"id": "mia", "name": "Erfinderin Mia", "icon": "👧", "text": "baut aus allem etwas Neues", "farben": ["#0d9488", "#6b21a8", "#1c1917"], "geschichten": [{"text": "Mia baut einen Roboter. Es fehlt nur noch ein Zahnrad – und eine gute Rechnung.", "stueck": {"id": "mia-zahnrad", "name": "Zahnrad", "icon": "⚙️"}}, {"text": "Mia hat einen Drachen gebaut. Hilf ihr, dass er richtig fliegt!", "stueck": {"id": "mia-drachen", "name": "Selbstgebauter Drachen", "icon": "🪁"}}]},
    {"id": "minka", "name": "Katze Minka", "icon": "🐈", "text": "gehört irgendwie allen", "farben": ["#f97316", "#f97316", "#f97316"], "tier": "katze", "geschichten": [{"text": "Minka ist verschwunden! Suche mit – bestimmt versteckt sie sich irgendwo.", "stueck": {"id": "minka-gloeckchen", "name": "Katzenglöckchen", "icon": "🎐"}}, {"text": "Minka spielt mit Wolle und hat alles verknotet. Entwirrst du das Knäuel?", "stueck": {"id": "minka-wolle", "name": "Wollknäuel", "icon": "🧶"}}]}
  ],

